rules_version = '2';
// 체크아웃 10분 전 랭킹 규칙 — Firebase 콘솔 → Firestore → 규칙 에 붙여 넣기
service cloud.firestore {
  match /databases/{database}/documents {
    match /escape707_ranks/{uid} {
      // 랭킹은 누구나 볼 수 있다
      allow read: if true;
      // 자기 기록만, 더 빠른 기록으로만 쓸 수 있다. 3분 미만·하루 초과 기록은 거부
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'sec', 'hints', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 12
        && request.resource.data.sec is int
        && request.resource.data.sec >= 180
        && request.resource.data.sec <= 86400
        && request.resource.data.hints is int
        && request.resource.data.hints >= 0
        && request.resource.data.at == request.time
        && (resource == null || request.resource.data.sec < resource.data.sec);
      allow delete: if false;
    }
  }
}
